# ==============================================================================
# Arogya Vision Environment Variables (Example)
# ==============================================================================
# This file documents the non-secret configuration required for the current
# Next.js frontend + FastAPI backend architecture.
#
# DO NOT ADD SECRETS, CREDENTIALS, OR REAL TOKENS TO THIS FILE.
# ==============================================================================

# NEXT_PUBLIC_API_BASE_URL is the FastAPI base URL consumed by Next.js.
# For local development, this defaults to the Uvicorn default port 8000.
# Production deployments must replace localhost with their actual API origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# CORS_ORIGINS is a comma-separated list of permitted frontend origins.
# FastAPI will accept requests from these domains.
# Production deployments must replace localhost values with their actual frontend origin.
CORS_ORIGINS=http://localhost:3000
